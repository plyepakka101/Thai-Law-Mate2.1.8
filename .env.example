# Neon Serverless PostgreSQL Connection String
# Get yours from the Neon Console.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_ENDPOINT.neon.tech/neondb?sslmode=require

# Google Gemini API Key (for legal AI assistant features)
GEMINI_API_KEY=

# Authentication / Admin configuration
# IMPORTANT: set these in Vercel Environment Variables. Do not commit real values.
# Generate a random value of at least 32 characters.
AUTH_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Same Google OAuth Web Client ID must be configured in both variables.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Comma-separated server-side Admin allowlist.
ADMIN_EMAILS=pramot.thamwi@gmail.com,plyepakka@gmail.com

# Optional password login for Admin. Use a strong random password (12+ chars).
# Leave unset if you want Google-only admin authentication.
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
